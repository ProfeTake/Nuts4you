# ─── Servidor ────────────────────────────────────────────────────────────────
PUERTO=3001
NODE_ENV=development

# ─── Base de datos MySQL ──────────────────────────────────────────────────────
# Local (XAMPP): mysql://root:@localhost:3306/nuts4you_db
# Railway: la variable DATABASE_URL es inyectada automáticamente por el plugin MySQL
DATABASE_URL="mysql://root:@localhost:3306/nuts4you_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="nuts4you_dev_secret_cambiar_en_prod"
JWT_EXPIRACION="8h"

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL exacta del frontend en producción (sin barra final)
# En Railway: poner la URL del servicio frontend, ej: https://nuts4you.up.railway.app
# En desarrollo: dejar vacío (se permite cualquier origen)
FRONTEND_URL=""
