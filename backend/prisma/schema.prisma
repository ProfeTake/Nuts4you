generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id            Int         @id @default(autoincrement())
  rol_id        Int
  pdv_id        Int?
  rut           String      @unique
  nombre        String
  email         String?     @unique
  password_hash String
  activo        Boolean     @default(true)
  pago_diario   Int         @default(28000)
  rol           Rol         @relation(fields: [rol_id], references: [id])
  pdv           PDV?        @relation(fields: [pdv_id], references: [id])
  turnos              TurnoCaja[]
  retiros_realizados  RetiroTurno[]
  solicitudes         Solicitud[]
  turnos_planeados    TurnoPlaneado[]
  notificaciones      Notificacion[]
  cierres_preventivos CierrePreventivo[]
}

enum TipoPDV {
  BODEGA
  PUNTO_VENTA
}

model PDV {
  id                  Int             @id @default(autoincrement())
  nombre              String
  tipo                TipoPDV
  activo              Boolean         @default(true)
  inventario          Inventario[]
  turnos              TurnoCaja[]
  usuarios            Usuario[]
  movimientos_origen  MovimientoInv[] @relation("PDVOrigen")
  movimientos_destino MovimientoInv[] @relation("PDVDestino")
  registros_diarios   RegistroDiario[]
  solicitudes         Solicitud[]
  turnos_planeados    TurnoPlaneado[]
  cierres_preventivos CierrePreventivo[]
  config_bonos        ConfigBono[]
}

/// Tramos de bono por sucursal, editables por el admin (reemplaza la tabla
/// hardcodeada en calculos.servicio.ts). Cada fila = un umbral de venta diaria
/// que otorga un monto de bono. Se evalúan de mayor a menor umbral (primer match gana).
model ConfigBono {
  id           Int      @id @default(autoincrement())
  pdv_id       Int
  umbral_venta Int // venta diaria mínima en CLP para obtener este bono
  monto_bono   Int // monto del bono en CLP
  activo       Boolean  @default(true)
  creado_en    DateTime @default(now())
  actualizado_en DateTime @updatedAt
  pdv          PDV      @relation(fields: [pdv_id], references: [id], onDelete: Cascade)

  @@unique([pdv_id, umbral_venta])
  @@index([pdv_id])
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id            Int             @id @default(autoincrement())
  categoria_id  Int
  nombre        String
  precio_venta  Int
  costo         Int
  activo        Boolean         @default(true)
  codigo_barra  String?         @unique
  categoria     Categoria       @relation(fields: [categoria_id], references: [id])
  inventarios   Inventario[]
  movimientos   MovimientoInv[]
  solicitudes   SolicitudItem[]
}

model Inventario {
  id            Int      @id @default(autoincrement())
  pdv_id        Int
  producto_id   Int
  stock_actual  Int      @default(0)
  stock_critico Int      @default(0)
  pdv           PDV      @relation(fields: [pdv_id], references: [id])
  producto      Producto @relation(fields: [producto_id], references: [id])

  @@unique([pdv_id, producto_id])
  // pdv_id ya indexado por MySQL como FK (@@unique también crea índice)
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

model TurnoCaja {
  id                  Int           @id @default(autoincrement())
  pdv_id              Int
  usuario_id          Int?
  fecha_apertura      DateTime      @default(now())
  fecha_cierre        DateTime?
  saldo_inicial       Int           @default(0)
  efectivo_declarado  Int?
  diferencia_caja     Int?          // almacenado al cierre (auditabilidad financiera)
  venta_efectivo      Int?
  venta_tarjeta       Int?
  venta_transferencia Int?
  total_calculado     Int?          // total declarado al cierre (stock flow)
  estado              EstadoTurno   @default(ABIERTO)
  pdv                 PDV           @relation(fields: [pdv_id], references: [id])
  usuario             Usuario?      @relation(fields: [usuario_id], references: [id])
  gastos              GastoTurno[]
  depositos           Deposito[]
  retiros             RetiroTurno[]

  // FK (pdv_id, usuario_id) ya indexadas por MySQL automáticamente
  @@index([fecha_apertura])
  @@index([estado])
}

// GastoTurno — gastos registrados durante el turno (art. aseo, líquidos, etc.)
model GastoTurno {
  id          Int       @id @default(autoincrement())
  turno_id    Int
  descripcion String
  monto       Int
  turno       TurnoCaja @relation(fields: [turno_id], references: [id])
  // turno_id ya indexado por MySQL como FK
}

// RetiroTurno — retiros de efectivo realizados durante el turno
model RetiroTurno {
  id          Int       @id @default(autoincrement())
  turno_id    Int
  usuario_id  Int?
  monto       Int
  descripcion String?
  fecha_hora  DateTime  @default(now())
  turno       TurnoCaja @relation(fields: [turno_id], references: [id])
  usuario     Usuario?  @relation(fields: [usuario_id], references: [id])
  // turno_id, usuario_id ya indexados por MySQL como FK
}

// Deposito — seguimiento de depósitos bancarios por turno
model Deposito {
  id            Int            @id @default(autoincrement())
  turno_id      Int
  monto_teorico Int
  monto_real    Int
  fecha         DateTime       @default(now())
  estado        EstadoDeposito @default(PENDIENTE)
  turno         TurnoCaja      @relation(fields: [turno_id], references: [id])

  @@index([estado])
}

enum EstadoDeposito {
  PENDIENTE
  CONFIRMADO
  TRANSFERENCIA
}

enum TipoMovimiento {
  INGRESO
  TRASPASO
  VENTA
  MERMA
}

enum EstadoSolicitud {
  PENDIENTE
  DESPACHADA
  CONFIRMADA
}

model MovimientoInv {
  id             Int            @id @default(autoincrement())
  lote_id        String?        @db.VarChar(36) // agrupa los ítems de un mismo despacho
  producto_id    Int
  pdv_origen_id  Int?
  pdv_destino_id Int?
  tipo           TipoMovimiento
  cantidad       Int
  fecha          DateTime       @default(now())
  producto       Producto       @relation(fields: [producto_id], references: [id])
  pdv_origen     PDV?           @relation("PDVOrigen", fields: [pdv_origen_id], references: [id])
  pdv_destino    PDV?           @relation("PDVDestino", fields: [pdv_destino_id], references: [id])

  // producto_id ya indexado por MySQL como FK
  @@index([lote_id])
  @@index([fecha])
  @@index([tipo])
}

/// Historial de ingresos/ajustes de stock en la Bodega Central.
/// Cada fila guardada en la tabla de inventario (con ingresos o utilizadas)
/// genera un registro con snapshot del nombre, saldos y quién/cuándo lo hizo.
model HistorialInventario {
  id             Int      @id @default(autoincrement())
  lote_id        String?  @db.VarChar(36) // agrupa los ítems guardados en un mismo "Guardar"
  inventario_id  Int?
  producto_id    Int?
  nombre         String   // snapshot del nombre del ítem al momento del registro
  saldo_anterior Int
  ingresos       Int
  utilizadas     Int
  saldo_nuevo    Int
  usuario_id     Int?     // snapshot (sin FK): sobrevive a la eliminación del usuario
  usuario_nombre String?
  creado_en      DateTime @default(now())

  @@index([lote_id])
  @@index([creado_en])
}

model RegistroDiario {
  id        Int      @id @default(autoincrement())
  pdv_id    Int
  fecha     DateTime @db.Date
  datos     Json
  creado_en DateTime @default(now())
  pdv       PDV      @relation(fields: [pdv_id], references: [id])

  @@unique([pdv_id, fecha])
}

model Solicitud {
  id           Int             @id @default(autoincrement())
  pdv_id       Int
  usuario_id   Int?
  estado       EstadoSolicitud @default(PENDIENTE)
  notas        String?
  fecha        DateTime        @default(now())
  fecha_cierre DateTime?
  pdv          PDV             @relation(fields: [pdv_id], references: [id])
  usuario      Usuario?        @relation(fields: [usuario_id], references: [id])
  items        SolicitudItem[]

  // pdv_id ya indexado por MySQL como FK
  @@index([estado])
  @@index([fecha])
}

model SolicitudItem {
  id           Int       @id @default(autoincrement())
  solicitud_id Int
  producto_id  Int
  cantidad     Int
  solicitud    Solicitud @relation(fields: [solicitud_id], references: [id])
  producto     Producto  @relation(fields: [producto_id], references: [id])
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  titulo     String
  mensaje    String   @db.Text
  leida      Boolean  @default(false)
  fecha      DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  // usuario_id ya indexado como FK por MySQL
  @@index([leida])
  @@index([fecha])
}

model TurnoPlaneado {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @db.Date
  pdv_id     Int
  usuario_id Int
  publicado  Boolean  @default(false)
  pdv        PDV      @relation(fields: [pdv_id], references: [id])
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])

  @@unique([fecha, pdv_id])
  // usuario_id ya indexado por MySQL como FK; fecha cubierta por el @@unique
  @@index([fecha])
}

// ─── Módulo de Facturas de Proveedores ───────────────────────────────────────

model Proveedor {
  id            Int                @id @default(autoincrement())
  nombre        String
  rut           String?            @unique
  contacto      String?
  activo        Boolean            @default(true)
  banco         String?
  tipo_cuenta   String?
  numero_cuenta String?
  facturas      FacturaProveedor[]
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

model FacturaProveedor {
  id                Int              @id @default(autoincrement())
  proveedor_id      Int
  numero_factura    String
  fecha             DateTime         @db.Date
  fecha_vencimiento DateTime?        @db.Date
  monto_total       Int
  estado            EstadoFactura    @default(PENDIENTE)
  notas             String?          @db.Text
  creado_en         DateTime         @default(now())
  proveedor         Proveedor        @relation(fields: [proveedor_id], references: [id])
  items             DetalleFactura[]

  @@index([fecha])
  @@index([estado])
  @@index([proveedor_id])
}

model DetalleFactura {
  id              Int              @id @default(autoincrement())
  factura_id      Int
  descripcion     String
  cantidad        Int
  precio_unitario Int
  factura         FacturaProveedor @relation(fields: [factura_id], references: [id], onDelete: Cascade)
  // factura_id indexado por MySQL como FK
}

// ─── Plantilla de tareas para Cierre Preventivo ──────────────────────────────

model TareaChecklist {
  id    Int    @id @default(autoincrement())
  label String
  orden Int    @default(0)
}

// ─── Cierre Preventivo ────────────────────────────────────────────────────────

model CierrePreventivo {
  id             Int      @id @default(autoincrement())
  pdv_id         Int
  usuario_id     Int
  fecha          DateTime @default(now())
  monto_retiro   Int      @default(0)
  checklist      Json
  notas_vendedor String?  @db.Text
  observaciones  String?  @db.Text
  pdv            PDV      @relation(fields: [pdv_id], references: [id])
  usuario        Usuario  @relation(fields: [usuario_id], references: [id])

  @@index([pdv_id])
  @@index([fecha])
}
