{
  "name": "nuts-4-you",
  "version": "1.0.0",
  "description": "ERP/POS Nuts 4 You - Monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BACK,FRONT -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n BACK,FRONT -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
